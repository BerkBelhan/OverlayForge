<Window x:Class="OverlayForge.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OverlayForge.UI.ViewModels"
        xmlns:converters="clr-namespace:OverlayForge.UI.Converters"
        Title="OverlayForge"
        Width="420" Height="680"
        MinWidth="360" MinHeight="500"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:OpacityToPercentConverter x:Key="OpacityPercent"/>
        <converters:LockStatusConverter x:Key="LockStatus"/>
        <converters:ClickThroughStatusConverter x:Key="CTStatus"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Overlay list -->
            <RowDefinition Height="Auto"/>  <!-- Preset bar -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Title Bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬡" FontSize="18" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="OverlayForge"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Settings"
                            Click="SettingsButton_Click"
                            Content="⚙" FontSize="16"
                            Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Minimize to tray"
                            Click="MinimizeButton_Click"
                            Content="─" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Toolbar ────────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                Padding="8,6"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal">

                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding OverlayList.AddOverlayFromFileCommand}"
                        ToolTip="Add overlay from image file (Ctrl+O)"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontWeight="Bold"/>
                        <TextBlock Text="Add Image" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding OverlayList.AddEmptyOverlayCommand}"
                        ToolTip="Add empty overlay"
                        Margin="0,0,6,0">
                    <TextBlock Text="+ Empty"/>
                </Button>

                <Separator Width="1"
                        Height="24"
                        Margin="0,0,6,0"/>

                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding OverlayList.ShowAllCommand}"
                        ToolTip="Show all overlays"
                        Margin="0,0,6,0">
                    <TextBlock Text="👁 All"/>
                </Button>

                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding OverlayList.HideAllCommand}"
                        ToolTip="Hide all overlays"
                        Margin="0,0,12,0">
                    <TextBlock Text="🙈 Hide"/>
                </Button>
                <Separator Width="1" Height="24" HorizontalAlignment="Center" Margin="12,0,12,0"/>
                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding OpenLoadModalCommand}" 
                        ToolTip="Load Preset" 
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Load"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding OpenSaveModalCommand}" 
                        ToolTip="Save Preset">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Save"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ── Overlay List ───────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="OVERLAYS"
                       FontSize="{StaticResource FontSizeSmall}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="4,0,0,6"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding OverlayList.Overlays}"
                     SelectionMode="Extended"
                     Background="{StaticResource SurfaceBrush}"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlayItemViewModel}">
                        <Border Margin="0,2" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 1: Name and action buttons -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ImagePath}"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}"
                                                Command="{Binding ToggleVisibilityCommand}"
                                                ToolTip="Toggle visibility"
                                                Content="👁" FontSize="12"
                                                Margin="0,0,2,0"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Command="{Binding ToggleLockCommand}"
                                                ToolTip="{Binding IsLocked, Converter={StaticResource LockStatus}}"
                                                Content="🔒" FontSize="12"
                                                Margin="0,0,2,0"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Command="{Binding ToggleClickThroughCommand}"
                                                ToolTip="{Binding IsClickThrough, Converter={StaticResource CTStatus}}"
                                                Content="⊙" FontSize="12"
                                                Margin="0,0,2,0"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Command="{Binding DuplicateCommand}"
                                                ToolTip="Duplicate overlay"
                                                Content="⧉" FontSize="12"
                                                Margin="0,0,2,0"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Command="{Binding RemoveCommand}"
                                                ToolTip="Remove overlay"
                                                Foreground="{StaticResource DangerBrush}"
                                                Content="✕" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Opacity slider -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               Text="Opacity"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Slider Grid.Column="1"
                                            Value="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0" Maximum="1"
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            TickFrequency="0.05"
                                            VerticalAlignment="Center"
                                            Margin="6,0"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Opacity, Converter={StaticResource OpacityPercent}}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Row 3: Status indicators -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="{StaticResource DangerBrush}"
                                            CornerRadius="2" Padding="4,1"
                                            Visibility="{Binding IsClickThrough, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="CLICK-THROUGH" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{StaticResource WarningBrush}"
                                            CornerRadius="2" Padding="4,1"
                                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="LOCKED" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceElevatedBrush}"
                                            CornerRadius="2" Padding="4,1"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                        <TextBlock Text="HIDDEN" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ── Preset Bar ─────────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
                    <Grid>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                    </Grid>
                </Border>

        <Grid Grid.RowSpan="4" Background="#CC000000" Panel.ZIndex="100" 
                Visibility="{Binding IsSaveModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Padding="28" Width="400">
                    <StackPanel>
                        <TextBlock Text="Save Selected Overlays" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock Text="Preset Name:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        
                        <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,30" Padding="8,6"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CloseModalsCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Save Preset" Command="{Binding ConfirmSavePresetCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="4" Background="#CC000000" Panel.ZIndex="100" 
                Visibility="{Binding IsLoadModalOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Padding="28" Width="450">
                    <StackPanel>
                        <TextBlock Text="Load Preset" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        
                        <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" 
                                DisplayMemberPath="Name" Height="220" Margin="0,0,0,30"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CloseModalsCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Load Selected" Command="{Binding ConfirmLoadPresetCommand}"/>
                        </StackPanel>
                    </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
