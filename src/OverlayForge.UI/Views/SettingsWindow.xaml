<Window x:Class="OverlayForge.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OverlayForge.UI.ViewModels"
        xmlns:converters="clr-namespace:OverlayForge.UI.Converters"
        Title="OverlayForge — Settings"
        Width="580" Height="600"
        MinWidth="480" MinHeight="500"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="{StaticResource FontSizeTitle}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <TabControl Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}">

            <!-- ── General Tab ─────────────────────────────────────── -->
            <TabItem Header="General">
                <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <GroupBox Header="Opacity" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16">
                            <StackPanel Margin="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Step per hotkey press:"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1"
                                            Value="{Binding OpacityStep, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="0.01" Maximum="0.25"
                                            SmallChange="0.01" TickFrequency="0.01"
                                            VerticalAlignment="Center" Margin="8,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding OpacityStep, StringFormat={}{0:P0}}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Snapping" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16">
                            <StackPanel Margin="8">
                                <CheckBox Content="Snap to screen edges"
                                          IsChecked="{Binding SnapToEdges}" Margin="0,0,0,8"/>
                                <CheckBox Content="Snap to center lines"
                                          IsChecked="{Binding SnapToCenterLines}" Margin="0,0,0,8"/>
                                <CheckBox Content="Snap to other overlays"
                                          IsChecked="{Binding SnapToOtherOverlays}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Snap distance (px):"
                                               VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1"
                                            Value="{Binding SnapDistance, UpdateSourceTrigger=PropertyChanged}"
                                            Minimum="2" Maximum="40" SmallChange="1"
                                            VerticalAlignment="Center" Margin="8,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SnapDistance}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Startup &amp; Behavior" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel Margin="8">
                                <CheckBox Content="Start minimized to system tray"
                                          IsChecked="{Binding StartMinimized}" Margin="0,0,0,8"/>
                                <CheckBox Content="Minimize to tray (instead of taskbar)"
                                          IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,8"/>
                                <CheckBox Content="Auto-load last used preset on startup"
                                          IsChecked="{Binding AutoLoadLastPreset}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Hotkeys Tab ─────────────────────────────────────── -->
            <TabItem Header="Hotkeys" Foreground="Black">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Default hotkeys use Ctrl+Alt modifier. Changes take effect after clicking Save."/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding HotkeyBindings}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              RowBackground="{StaticResource SurfaceBrush}"
                              AlternatingRowBackground="{StaticResource SurfaceElevatedBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action"
                                                Binding="{Binding ActionLabel}"
                                                IsReadOnly="True"
                                                Width="150"/>
                            <DataGridTextColumn Header="Shortcut"
                                                Binding="{Binding DisplayString}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridCheckBoxColumn Header="Enabled"
                                                    Binding="{Binding IsEnabled}"
                                                    Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ── About Tab ───────────────────────────────────────── -->
            <TabItem Header="About">
                <StackPanel Margin="24" VerticalAlignment="Top">
                    <TextBlock Text="OverlayForge"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Version 1.0.0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap"
                               Text="A modern, lightweight transparent overlay system for gaming and design workflows. Inspired by Glass2k with modern architecture and multi-overlay support."
                               Margin="0,0,0,12"/>
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock Text="Default Hotkeys:" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}"
                               Text="Ctrl+Alt+Up    — Opacity Up&#x0a;Ctrl+Alt+Down  — Opacity Down&#x0a;Ctrl+Alt+C     — Toggle Click-Through&#x0a;Ctrl+Alt+H     — Toggle Visibility&#x0a;Ctrl+Alt+L     — Toggle Lock"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock Text="Open Source — MIT License"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmall}"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource SuccessBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Margin="0,0,8,0"/>
            <Button Style="{StaticResource SecondaryButton}"
                    Command="{Binding ResetToDefaultsCommand}"
                    Content="Reset Defaults"
                    Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveSettingsCommand}"
                    Content="Save Settings"/>
        </StackPanel>
    </Grid>
</Window>
