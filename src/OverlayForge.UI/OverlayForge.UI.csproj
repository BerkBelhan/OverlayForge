<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>OverlayForge</AssemblyName>
    <RootNamespace>OverlayForge.UI</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <StartupObject>OverlayForge.UI.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OverlayForge.Core\OverlayForge.Core.csproj" />
    <ProjectReference Include="..\OverlayForge.Configuration\OverlayForge.Configuration.csproj" />
    <ProjectReference Include="..\OverlayForge.Infrastructure\OverlayForge.Infrastructure.csproj" />
    <ProjectReference Include="..\OverlayForge.Win32\OverlayForge.Win32.csproj" />
    <ProjectReference Include="..\OverlayForge.OverlayEngine\OverlayForge.OverlayEngine.csproj" />
    <ProjectReference Include="..\OverlayForge.Hotkeys\OverlayForge.Hotkeys.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows Forms for system tray NotifyIcon -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
